CREATE TABLE custom_audio_track (
    id TEXT NOT NULL PRIMARY KEY,
    display_name TEXT NOT NULL,
    local_path TEXT NOT NULL,
    duration_ms INTEGER NOT NULL,
    size_bytes INTEGER NOT NULL,
    added_at INTEGER NOT NULL
);

CREATE INDEX custom_audio_added_idx ON custom_audio_track(added_at);

selectAll:
SELECT * FROM custom_audio_track ORDER BY added_at DESC;

selectById:
SELECT * FROM custom_audio_track WHERE id = :id;

insert:
INSERT INTO custom_audio_track (id, display_name, local_path, duration_ms, size_bytes, added_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM custom_audio_track WHERE id = :id;
